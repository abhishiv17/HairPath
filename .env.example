YOUCAM_API_KEY=your_youcam_api_key_here
YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# Optional: Supabase (barber link, sync for signed-in users, community pulse). Leave empty to run device-only.
# Supabase → Project Settings → API Keys. The publishable (or legacy anon) key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: lets HairPath's server record anonymous try-on counts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: "Ask Pip anything" (AI answers through Groq). Leave empty and Pip uses its built-in help only.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
